{
    "name": "vinnik/shorter",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6",
        "nelmio/api-doc-bundle": "^5.12",
        "nelmio/cors-bundle": "^2.6",
        "symfony/asset": "~7.2.0",
        "symfony/console": "~7.2.0",
        "symfony/doctrine-messenger": "~7.2.0",
        "symfony/dotenv": "~7.2.0",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "~7.2.0",
        "symfony/messenger": "~7.2.0",
        "symfony/runtime": "~7.2.0",
        "symfony/serializer": "~7.2.0",
        "symfony/twig-bundle": "~7.2.0",
        "symfony/uid": "~7.2.0",
        "symfony/validator": "~7.2.0",
        "symfony/yaml": "~7.2.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.3",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "ergebnis/composer-normalize": "*",
        "fakerphp/faker": "^1.24",
        "phpro/grumphp": "*",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "^11.5",
        "qossmic/deptrac-shim": "*",
        "symfony/browser-kit": "~7.2.0",
        "symfony/maker-bundle": "^1.67"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Application\\": "src/Application/",
            "Domain\\": "src/Domain/",
            "Infrastructure\\": "src/Infrastructure/",
            "UserInterface\\": "src/UserInterface/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.2.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
